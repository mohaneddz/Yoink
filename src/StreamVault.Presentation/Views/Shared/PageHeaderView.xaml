<UserControl x:Class="StreamVault.Presentation.Views.Shared.PageHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Name="Root">
    <Grid Margin="0,28,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding HeaderTitle, ElementName=Root}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding HeaderTagline, ElementName=Root}" Style="{StaticResource PageTaglineText}"
                       Margin="24,0,0,20" VerticalAlignment="Bottom"/>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
            <TextBlock x:Name="ClockText" FontFamily="{StaticResource InterfaceFont}" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"
                       Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="DateText" FontFamily="{StaticResource InterfaceFont}" FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
