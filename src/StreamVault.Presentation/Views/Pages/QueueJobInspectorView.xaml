<UserControl x:Class="StreamVault.Presentation.Views.Pages.QueueJobInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:StreamVault.Presentation.Converters"
             xmlns:models="clr-namespace:StreamVault.Presentation.ViewModels.Models"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance models:QueueJob}">

    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:QueueJobStatusToLabelConverter x:Key="StatusLabelConverter"/>
        <conv:QueueJobStatusToBrushConverter x:Key="StatusBrushConverter"/>
        <conv:EnumEqualsToVisibilityConverter x:Key="EnumEqualsToVisibility"/>

        <Style x:Key="InspectorTab" TargetType="RadioButton" BasedOn="{StaticResource FilterTabButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ReadonlyField" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,20,20,0">
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{Binding ThumbnailHex}" Width="60" Height="42" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="200">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,2,0,0">
                            <Run Text="{Binding Channel, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <Run Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                            <Run Text="{Binding Quality, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding DataContext.Inspector.CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton Style="{StaticResource InspectorTab}" GroupName="InspectorTab" Content="DETAILS" Margin="0,0,20,0"
                             Command="{Binding SelectTabCommand}" CommandParameter="Details"
                             IsChecked="{Binding SelectedInspectorTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Details, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource InspectorTab}" GroupName="InspectorTab" Content="LOG" Margin="0,0,20,0"
                             Command="{Binding SelectTabCommand}" CommandParameter="Log"
                             IsChecked="{Binding SelectedInspectorTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Log, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource InspectorTab}" GroupName="InspectorTab" Content="INFO"
                             Command="{Binding SelectTabCommand}" CommandParameter="Info"
                             IsChecked="{Binding SelectedInspectorTab, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Info, Mode=OneWay}"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="-20,0,-20,16"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
            <StackPanel>

                <StackPanel Visibility="{Binding SelectedInspectorTab, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Details}">
                    <TextBlock Text="SOURCE URL" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource ReadonlyField}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLink}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SourceUrl}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SELECTED FORMAT" Style="{StaticResource FieldLabel}"/>
                    <Border Style="{StaticResource ReadonlyField}" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFilm}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SelectedFormatText}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ReadonlyField}">
                            <TextBlock Text="{Binding OutputFolder}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="11" Content="BROWSE"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding StatusDetailText}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="14,8" FontSize="11" Content="RESUME"
                                Command="{Binding ResumeCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ADDED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding AddedAtText}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LAST UPDATE" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding LastUpdateText}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FILE SIZE" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding FileSizeText}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DOWNLOADED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DownloadedText}" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="LOG PREVIEW" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                        <TextBlock Text="CLEAR" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Foreground="{StaticResource OrangePrimaryBrush}"/>
                    </Grid>
                    <Border Background="{StaticResource LogPanelBrush}" Padding="12" Height="150" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FFB8B8B8" TextWrapping="Wrap" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="NOTES" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                              MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                </StackPanel>

                <StackPanel Visibility="{Binding SelectedInspectorTab, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Log}">
                    <Border Background="{StaticResource LogPanelBrush}" Padding="12">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FFB8B8B8" TextWrapping="Wrap" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding SelectedInspectorTab, Converter={StaticResource EnumEqualsToVisibility}, ConverterParameter=Info}">
                    <TextBlock Text="RETRY COUNT" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding RetryCount}" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="DESTINATION" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Destination}" FontWeight="SemiBold"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
