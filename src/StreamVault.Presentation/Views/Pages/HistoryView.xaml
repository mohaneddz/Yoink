<UserControl x:Class="StreamVault.Presentation.Views.Pages.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:StreamVault.Presentation.Views.Shared"
             xmlns:conv="clr-namespace:StreamVault.Presentation.Converters"
             xmlns:vm="clr-namespace:StreamVault.Presentation.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:HistoryViewModel}">

    <UserControl.Resources>
        <conv:HistoryResultToBrushConverter x:Key="ResultBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="ToolbarLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,0,20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarLinkText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,0,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:PageHeaderView Grid.Row="0" HeaderTitle="HISTORY" HeaderTagline="REVIEW. RETRY. AUDIT."/>

        <!-- Search + date range -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource TextMutedBrush}" Margin="14,0,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" BorderThickness="0" Padding="10,12"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconCalendar}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource TextMutedBrush}" Margin="14,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding DateRangeText}" FontSize="13" VerticalAlignment="Center"/>
                    <Path Grid.Column="2" Data="{StaticResource IconChevronDown}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextMutedBrush}" Margin="0,0,14,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Style="{StaticResource FieldComboBox}" Text="{Binding ResultFilter}" IsEditable="True" IsReadOnly="True"/>
            <ComboBox Grid.Column="2" Style="{StaticResource FieldComboBox}" Text="{Binding SourceTypeFilter}" IsEditable="True" IsReadOnly="True"/>
            <ComboBox Grid.Column="4" Style="{StaticResource FieldComboBox}" Text="{Binding FormatFilter}" IsEditable="True" IsReadOnly="True"/>
            <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFiltersCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="CLEAR FILTERS" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Toolbar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding RetrySelectedCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRotateCcw}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="RETRY SELECTED" Style="{StaticResource ToolbarLinkText}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding ReuseSettingsCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSliders}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="REUSE SETTINGS" Style="{StaticResource ToolbarLinkText}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="OPEN OUTPUT FOLDER" Style="{StaticResource ToolbarLinkText}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding CopySourceUrlCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconLink}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="COPY SOURCE URL" Style="{StaticResource ToolbarLinkText}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding ExportLogsCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconUpload}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="EXPORT LOGS" Style="{StaticResource ToolbarLinkText}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding ExportHistoryCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSave}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="EXPORT HISTORY" Style="{StaticResource ToolbarLinkText}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarLink}" Command="{Binding ClearHistoryCommand}" Padding="0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource ErrorBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="CLEAR HISTORY" Style="{StaticResource ToolbarLinkText}" Foreground="{StaticResource ErrorBrush}"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" Style="{StaticResource FlatDataGrid}" FontSize="11.5">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="4,8"/>
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                        <Setter Property="Padding" Value="4,0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="26">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource TableCheckBox}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding Index, StringFormat=00}" Width="26"/>
                    <DataGridTemplateColumn Header="TITLE" Width="2.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,3,0,0" Padding="5,1"
                                            Visibility="{Binding Redownloaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="REDOWNLOADED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel}" Width="1.1*"/>
                    <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding TimestampText}" Width="1.9*"/>
                    <DataGridTemplateColumn Header="RESULT" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="11" Height="11"
                                          Stroke="{Binding Result, Converter={StaticResource ResultBrushConverter}}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Result}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Result, Converter={StaticResource ResultBrushConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="OUTPUT" Binding="{Binding Output}" Width="1.1*"/>
                    <DataGridTextColumn Header="SIZE" Binding="{Binding FileSizeText}" Width="0.7*"/>
                    <DataGridTextColumn Header="FORMAT" Binding="{Binding Format}" Width="0.9*"/>
                    <DataGridTextColumn Header="DUR." Binding="{Binding DurationText}" Width="0.55*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
