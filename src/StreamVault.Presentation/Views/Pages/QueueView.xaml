<UserControl x:Class="StreamVault.Presentation.Views.Pages.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:StreamVault.Presentation.Views.Shared"
             xmlns:conv="clr-namespace:StreamVault.Presentation.Converters"
             xmlns:controls="clr-namespace:StreamVault.Presentation.Controls"
             xmlns:vm="clr-namespace:StreamVault.Presentation.ViewModels"
             xmlns:models="clr-namespace:StreamVault.Presentation.ViewModels.Models"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:QueueViewModel}">

    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:QueueJobStatusToLabelConverter x:Key="StatusLabelConverter"/>
        <conv:QueueJobStatusToBrushConverter x:Key="StatusBrushConverter"/>
        <conv:ProgressToStarWidthConverter x:Key="ProgressStarConverter"/>
        <conv:QueueJobStatusToActionIconConverter x:Key="ActionIconConverter"/>

        <Style x:Key="FilterCount" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Right-click menu for queue rows. PlacementTarget.Tag carries the page VM;
             PlacementTarget.DataContext is the QueueJob for this row. -->
        <ContextMenu x:Key="QueueRowMenu">
            <MenuItem Header="Resume"
                      Command="{Binding PlacementTarget.Tag.ResumeJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Pause"
                      Command="{Binding PlacementTarget.Tag.PauseJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconPause}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Retry"
                      Command="{Binding PlacementTarget.Tag.RetryJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Remove from queue" Style="{StaticResource DestructiveMenuItem}"
                      Command="{Binding PlacementTarget.Tag.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource ErrorBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="QueueRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
            <Setter Property="ContextMenu" Value="{StaticResource QueueRowMenu}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,0,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <shared:PageHeaderView Grid.Row="0" HeaderTitle="QUEUE" HeaderTagline="MONITOR. CONTROL. PRIORITIZE."/>

        <!-- Filter tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Style="{StaticResource FilterTabButton}" GroupName="QueueFilter" Margin="0,0,26,0"
                         Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static models:QueueFilter.Active}"
                         IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Active, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ACTIVE"/>
                    <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource FilterCount}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterTabButton}" GroupName="QueueFilter" Margin="0,0,26,0"
                         Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static models:QueueFilter.Queued}"
                         IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Queued, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="QUEUED"/>
                    <TextBlock Text="{Binding QueuedCount}" Style="{StaticResource FilterCount}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterTabButton}" GroupName="QueueFilter" Margin="0,0,26,0"
                         Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static models:QueueFilter.Paused}"
                         IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Paused, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PAUSED"/>
                    <TextBlock Text="{Binding PausedCount}" Style="{StaticResource FilterCount}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterTabButton}" GroupName="QueueFilter" Margin="0,0,26,0"
                         Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static models:QueueFilter.Completed}"
                         IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Completed, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="COMPLETED"/>
                    <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource FilterCount}"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterTabButton}" GroupName="QueueFilter"
                         Command="{Binding SelectFilterCommand}" CommandParameter="{x:Static models:QueueFilter.Failed}"
                         IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Failed, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FAILED"/>
                    <TextBlock Text="{Binding FailedCount}" Style="{StaticResource FilterCount}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" VerticalAlignment="Bottom" Margin="0,0,0,16"/>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Padding="16,10" Command="{Binding StartAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="White" Margin="0,0,7,0"/>
                        <TextBlock Text="START ALL" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PauseAllCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPause}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="PAUSE ALL" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearCompletedCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="CLEAR COMPLETED" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RetryFailedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="RETRY FAILED" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="MAX CONCURRENT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Style="{StaticResource FieldComboBox}" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding MaxConcurrent}" Width="70"/>
            </StackPanel>
        </Grid>

        <!-- Job table -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredJobs}" SelectedItem="{Binding SelectedJob}"
                      Style="{StaticResource FlatDataGrid}" RowStyle="{StaticResource QueueRowStyle}"
                      controls:DataGridBehaviors.SelectRowOnRightClick="True" FontSize="11" ColumnHeaderHeight="28">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}">
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="Padding" Value="3,6"/>
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                        <Setter Property="Padding" Value="3,0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="#" Width="22">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Order, StringFormat=00}" Style="{StaticResource MetaText}" FontSize="11"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="38">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ThumbnailHex}" Width="30" Height="22"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="3.2*" FontWeight="SemiBold" FontSize="11.5"/>
                    <DataGridTextColumn Header="CHANNEL" Binding="{Binding Channel}" Width="1.3*"/>
                    <DataGridTextColumn Header="FORMAT" Binding="{Binding Format}" Width="0.55*"/>
                    <DataGridTextColumn Header="QUALITY" Binding="{Binding Quality}" Width="0.95*"/>
                    <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="0.65*"/>
                    <DataGridTemplateColumn Header="PROGRESS" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" FontWeight="Bold" FontSize="11"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}" Margin="0,0,0,3"/>
                                    <Grid Height="4">
                                        <Border Background="{StaticResource SurfaceSecondaryBrush}"/>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressStarConverter}, ConverterParameter=fill}"/>
                                                <ColumnDefinition Width="{Binding Progress, Converter={StaticResource ProgressStarConverter}, ConverterParameter=track}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SPEED" Binding="{Binding SpeedText}" Width="0.75*"/>
                    <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="0.45*"/>
                    <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}" Width="1.15*"/>
                    <DataGridTemplateColumn Header="STATUS" Width="0.95*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusLabelConverter}}"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                           Style="{StaticResource StatusPillText}" FontSize="10"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22" ToolTip="Pause / resume"
                                            Command="{Binding DataContext.ToggleJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{Binding Status, Converter={StaticResource ActionIconConverter}}"
                                              Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="22" Height="22" Click="RowMenuButton_Click" ToolTip="More actions">
                                        <Path Data="{StaticResource IconMoreVertical}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding Jobs.Count, StringFormat={}{0} items}" Style="{StaticResource MetaText}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" ToolTip="Previous page">
                    <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextMutedBrush}"/>
                </Button>
                <Border Background="{StaticResource OrangePrimaryBrush}" Width="28" Height="28" Margin="4,0">
                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource IconButton}" ToolTip="Next page">
                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextMutedBrush}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
