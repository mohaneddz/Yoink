<UserControl x:Class="StreamVault.Presentation.Views.Pages.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:StreamVault.Presentation.Views.Shared"
             xmlns:conv="clr-namespace:StreamVault.Presentation.Converters"
             xmlns:controls="clr-namespace:StreamVault.Presentation.Controls"
             xmlns:vm="clr-namespace:StreamVault.Presentation.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ChannelsViewModel}">

    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:ChannelUploadTypeConverter x:Key="UploadTypeConverter"/>

        <Style x:Key="ChannelListItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource DisabledBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OrangePrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UploadRowItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Per-upload actions. PlacementTarget.Tag carries the page VM. -->
        <ContextMenu x:Key="UploadRowMenu">
            <MenuItem Header="Download"
                      Command="{Binding PlacementTarget.Tag.DownloadLatestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Add to queue"
                      Command="{Binding PlacementTarget.Tag.AddSelectedToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconClipboard}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Open channel"
                      Command="{Binding PlacementTarget.Tag.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="40,0,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:PageHeaderView Grid.Row="0" HeaderTitle="CHANNELS" HeaderTagline="FOLLOW. REVIEW. QUEUE."/>

        <!-- Add channel bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <TextBox Text="{Binding AddChannelUrl}" Style="{StaticResource FieldTextBox}" BorderThickness="0"
                         Padding="14,11" Tag="Paste YouTube channel URL here..."/>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding AddChannelCommand}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconClipboard}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="White" Margin="0,0,8,0"/>
                    <TextBlock Text="ADD CHANNEL"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding AddChannelCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="INSPECT" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Saved channels -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12">
                    <Run Text="SAVED CHANNELS ("/><Run Text="{Binding Channels.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Command="{Binding AddChannelCommand}" Padding="12,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="ADD CHANNEL" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ChannelListItem}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="34" Height="34" Fill="{Binding AvatarHex}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                    <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="11" Height="11" Stroke="{StaticResource SuccessBrush}" Margin="5,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Handle}" Style="{StaticResource MetaText}" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource MetaText}" FontSize="11">
                                            <Run Text="{Binding SubscriberCountText, Mode=OneWay}"/><Run Text=" subscribers"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon}" Width="10" Height="10" Stroke="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding VideoCountText}" Style="{StaticResource MetaText}" FontSize="11" Margin="0,0,10,0"/>
                                            <Path Data="{StaticResource IconFilm}" Style="{StaticResource Icon}" Width="10" Height="10" Stroke="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding ShortCountText}" Style="{StaticResource MetaText}" FontSize="11" Margin="0,0,10,0"/>
                                            <Path Data="{StaticResource IconList}" Style="{StaticResource Icon}" Width="10" Height="10" Stroke="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding PlaylistCountText}" Style="{StaticResource MetaText}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Selected channel uploads -->
            <DockPanel Grid.Column="2" d:DataContext="{Binding SelectedChannel}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <Grid DataContext="{Binding SelectedChannel}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="52" Height="52" Fill="{Binding AvatarHex}"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="17"/>
                                    <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource SuccessBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource MetaText}">
                                    <Run Text="{Binding Handle, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding SubscriberCountText, Mode=OneWay}"/><Run Text=" subscribers"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="LAST CHECKED" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding LastCheckedText}" FontSize="12" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="RECENT UPLOADS" Margin="0,0,22,0" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Recent Uploads"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='Recent Uploads', Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="VIDEOS" Margin="0,0,22,0"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="SHORTS" Margin="0,0,22,0"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="LIVESTREAMS" Margin="0,0,22,0"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="PLAYLISTS" Margin="0,0,22,0"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="ABOUT"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DividerBrush}" Margin="0,-14,0,16"/>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Run Text="{Binding DataContext.SelectedUploadCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" SELECTED"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Margin="0,0,8,0" Command="{Binding DataContext.AddSelectedToQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="ADD TO QUEUE" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Margin="0,0,8,0" Command="{Binding DataContext.DownloadLatestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="DOWNLOAD LATEST" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Command="{Binding DataContext.MarkAllAsSeenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="MARK AS SEEN" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Showing 1–25 of 842 items" Style="{StaticResource MetaText}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="16,9" FontSize="12" Content="LOAD MORE" FontWeight="Bold"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DataContext.Uploads, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UploadRowItem}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ContextMenu="{StaticResource UploadRowMenu}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource TableCheckBox}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Grid Grid.Column="1" Height="62" Margin="0,0,14,0">
                                            <Border Background="{Binding ThumbnailHex}"/>
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10" Background="#CC000000" Padding="4,1"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0">
                                                <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding ViewsText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding Type, Converter={StaticResource UploadTypeConverter}, ConverterParameter=bg}" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Type, Converter={StaticResource UploadTypeConverter}, ConverterParameter=label}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding Type, Converter={StaticResource UploadTypeConverter}, ConverterParameter=fg}"/>
                                            </Border>
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="More actions"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ContextMenu="{StaticResource UploadRowMenu}"
                                                    controls:ButtonBehaviors.OpensContextMenu="True">
                                                <Path Data="{StaticResource IconMoreVertical}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{StaticResource TextMutedBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Channel inspector -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top" DataContext="{Binding SelectedChannel}">
                <StackPanel>
                    <TextBlock Text="CHANNEL INSPECTOR" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="48" Height="48" Fill="{Binding AvatarHex}"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource SuccessBrush}" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Handle}" Style="{StaticResource MetaText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource PlainHoverButton}" Command="{Binding DataContext.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=Border}}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open Channel" Foreground="{StaticResource OrangePrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                            <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource Icon}" Width="11" Height="11" Stroke="{StaticResource OrangePrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="{Binding SubscriberCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="SUBSCRIBERS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding VideoCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="VIDEOS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding ShortCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="SHORTS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="{Binding LiveCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="LIVE STREAMS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding PlaylistCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="PLAYLISTS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding TotalViewsText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="TOTAL VIEWS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                    </UniformGrid>

                    <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="CHANNEL INFO" Style="{StaticResource SectionTitleText}" FontSize="12" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Joined" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding JoinedText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Country" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding CountryText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Language" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding LanguageText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Last Checked" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding LastCheckedText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,16"><TextBlock Text="Check Frequency" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding CheckFrequencyText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>

                    <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitleText}" FontSize="12" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="OPEN CHANNEL" Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=Border}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="DOWNLOAD LATEST" Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.DownloadLatestCommand, RelativeSource={RelativeSource AncestorType=Border}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="MARK ALL AS SEEN" Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.MarkAllAsSeenCommand, RelativeSource={RelativeSource AncestorType=Border}}"/>
                    <Button Style="{StaticResource DestructiveButton}" Content="UNFOLLOW CHANNEL" Padding="12,10" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.UnfollowChannelCommand, RelativeSource={RelativeSource AncestorType=Border}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
