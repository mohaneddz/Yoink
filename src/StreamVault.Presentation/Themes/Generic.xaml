<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:StreamVault.Presentation.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/StreamVault;component/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/StreamVault;component/Themes/Typography.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/StreamVault;component/Themes/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:NavItemButton}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource SidebarTextInactiveBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavItemButton}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ActiveBar" Grid.Column="0" Background="{StaticResource OrangePrimaryBrush}" Opacity="0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="21,0,0,0">
                            <Path Data="{TemplateBinding IconData}" Style="{StaticResource Icon}" Width="18" Height="18"
                                  Stroke="{TemplateBinding Foreground}" Margin="0,0,14,0"/>
                            <TextBlock Text="{TemplateBinding Label}" FontFamily="{StaticResource InterfaceFont}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter Property="Background" Value="{StaticResource SidebarActiveBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OrangePrimaryBrush}"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
