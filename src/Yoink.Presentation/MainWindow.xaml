<Window x:Class="Yoink.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Yoink.Presentation.Controls"
        xmlns:conv="clr-namespace:Yoink.Presentation.Converters"
        xmlns:nav="clr-namespace:Yoink.Presentation.Navigation"
        mc:Ignorable="d"
        Title="Yoink" Height="960" Width="1440" MinHeight="640" MinWidth="1080"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource SurfacePrimaryBrush}"
        FontFamily="{StaticResource InterfaceFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- Keyboard shortcuts (spec section 10). Contextual bindings (Ctrl+D/Q/R/O) resolve against
         whichever page view model is current and simply no-op when that page has no matching
         command — WPF leaves a Binding unresolved rather than throwing. Space/Delete for the Queue
         list live on QueueView itself so they don't fire while typing in an unrelated text field. -->
    <Window.InputBindings>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Queue}"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Playlists}"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Channels}"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Library}"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.History}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Settings}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleInspectorCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding CurrentPageViewModel.StartDownloadCommand}"/>
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding CurrentPageViewModel.AddToQueueCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding CurrentPageViewModel.RetryJobCommand}" CommandParameter="{Binding CurrentPageViewModel.SelectedJob}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding CurrentPageViewModel.SelectedJob.OpenFolderCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ==================== TITLE BAR ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource AppShellBrush}" BorderBrush="#FF1A1A1A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/yoink_sidebar_icon.png" Width="28" Height="28"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Image Source="Assets/yoink_wordmark.png" Height="20" Margin="9,1,0,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Width="46" Height="52" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Data="{StaticResource IconMinus}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="White"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Width="46" Height="52" Click="MaximizeButton_Click" ToolTip="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="{StaticResource IconSquare}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="White"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Width="46" Height="52" Click="CloseButton_Click" ToolTip="Close">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== BODY ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding Inspector.IsOpen, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=360}"/>
            </Grid.ColumnDefinitions>

            <!-- == SIDEBAR == -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                        <Border Height="1" Background="#FF1A1A1A" Margin="24,0,24,18"/>
                        <StackPanel Margin="24,0,24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SYSTEM STATUS" Foreground="{DynamicResource SidebarTextMutedBrush}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Ellipse Width="7" Height="7" Fill="{Binding SystemStatus.DotBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SystemStatus.StateLabel}" Foreground="White" FontWeight="Bold"
                                       FontSize="19" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding SystemStatus.Detail}" Foreground="{DynamicResource SidebarTextMutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0">
                        <controls:NavItemButton Label="DOWNLOAD" IconData="{StaticResource IconDownload}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Download}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Download}"/>
                        <controls:NavItemButton Label="QUEUE" IconData="{StaticResource IconList}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Queue}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Queue}"/>
                        <controls:NavItemButton Label="PLAYLISTS" IconData="{StaticResource IconLayers}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Playlists}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Playlists}"/>
                        <controls:NavItemButton Label="CHANNELS" IconData="{StaticResource IconUser}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Channels}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Channels}"/>
                        <controls:NavItemButton Label="LIBRARY" IconData="{StaticResource IconArchive}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Library}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Library}"/>
                        <controls:NavItemButton Label="HISTORY" IconData="{StaticResource IconClock}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.History}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=History}"/>
                        <Border Height="1" Background="#FF1A1A1A" Margin="24,14,24,14"/>
                        <controls:NavItemButton Label="SETTINGS" IconData="{StaticResource IconSettings}"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Settings}"
                                                 IsActive="{Binding CurrentPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Settings}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- == MAIN CONTENT == -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}" Background="{DynamicResource SurfacePrimaryBrush}"/>

            <!-- == INSPECTOR == -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding Inspector.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl Content="{Binding Inspector.Content}"/>
            </Border>
        </Grid>

        <!-- ==================== STATUS STRIP ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource AppShellBrush}" BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="24,0">

                <Button Style="{StaticResource PlainHoverButton}" Height="64" Padding="0" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Queue}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}" Width="18" Height="18" Stroke="{DynamicResource SidebarTextMutedBrush}"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="ACTIVE DOWNLOADS" Style="{StaticResource StatusLabelText}"/>
                            <TextBlock Text="{Binding StatusStrip.ActiveDownloads}" Style="{StaticResource StatusValueText}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="#FF1A1A1A" Margin="24,18"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconActivity}" Style="{StaticResource Icon}" Width="18" Height="18" Stroke="{DynamicResource SidebarTextMutedBrush}"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="TOTAL SPEED" Style="{StaticResource StatusLabelText}"/>
                        <TextBlock Text="{Binding StatusStrip.TotalSpeedText}" Style="{StaticResource StatusValueText}"/>
                    </StackPanel>
                </StackPanel>

                <Border Width="1" Background="#FF1A1A1A" Margin="24,18"/>

                <Button Style="{StaticResource PlainHoverButton}" Height="64" Padding="0" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Queue}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconList}" Style="{StaticResource Icon}" Width="18" Height="18" Stroke="{DynamicResource SidebarTextMutedBrush}"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="FILES IN QUEUE" Style="{StaticResource StatusLabelText}"/>
                            <TextBlock Text="{Binding StatusStrip.FilesInQueue}" Style="{StaticResource StatusValueText}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="#FF1A1A1A" Margin="24,18"/>

                <Button Style="{StaticResource PlainHoverButton}" Height="64" Padding="0" Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Settings}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconHardDrive}" Style="{StaticResource Icon}" Width="18" Height="18" Stroke="{DynamicResource SidebarTextMutedBrush}"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="STORAGE" Style="{StaticResource StatusLabelText}"/>
                            <TextBlock Text="{Binding StatusStrip.StorageFreeText}" Style="{StaticResource StatusValueText}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="#FF1A1A1A" Margin="24,18"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconWifi}" Style="{StaticResource Icon}" Width="18" Height="18" Stroke="{StaticResource SuccessBrush}"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="NETWORK" Style="{StaticResource StatusLabelText}"/>
                        <TextBlock Text="{Binding StatusStrip.NetworkText}" Style="{StaticResource StatusValueText}" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
