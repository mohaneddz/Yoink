<UserControl x:Class="Yoink.Presentation.Views.Shared.SkeletonRowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" AutomationProperties.Name="Loading content">
    <UserControl.Resources>
        <Style x:Key="SkeletonBar" TargetType="Border">
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="24">
        <StackPanel.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </StackPanel.Triggers>
        <Border Style="{StaticResource SkeletonBar}" Width="170" Height="22" HorizontalAlignment="Left" Margin="0,0,0,24"/>
        <Border Style="{StaticResource SkeletonBar}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,20"/>
        <Border Style="{StaticResource SkeletonBar}" Height="64" Margin="0,0,0,12"/>
        <Border Style="{StaticResource SkeletonBar}" Height="64" Margin="0,0,0,12"/>
        <Border Style="{StaticResource SkeletonBar}" Height="64" Margin="0,0,0,12"/>
        <Border Style="{StaticResource SkeletonBar}" Height="64"/>
    </StackPanel>
</UserControl>
