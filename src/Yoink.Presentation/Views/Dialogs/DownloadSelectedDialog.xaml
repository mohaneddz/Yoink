<Window x:Class="Yoink.Presentation.Views.Dialogs.DownloadSelectedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Yoink.Presentation.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BatchDownloadDialogViewModel}"
        Title="Yoink" Height="540" Width="500"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfacePrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource InterfaceFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding HeadlineText}"
                       FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Text="Pick how they should be downloaded, then start them all."
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <!-- Video / Audio mode -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18">
                <RadioButton Style="{StaticResource FilterTabButton}" GroupName="BatchMode" Margin="0,0,28,0"
                             IsChecked="{Binding IsVideo, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,6,0"/>
                        <TextBlock Text="VIDEO"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource FilterTabButton}" GroupName="BatchMode"
                             IsChecked="{Binding IsAudio, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconMusic}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,6,0"/>
                        <TextBlock Text="AUDIO"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FieldComboBox}" Margin="0,6,0,0" Padding="12,9"
                                  ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding Container}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding QualityLabel}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FieldComboBox}" Margin="0,6,0,0" Padding="12,9"
                                  ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Quality}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16" Visibility="{Binding ShowSubtitles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="SUBTITLES" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource FieldComboBox}" Margin="0,6,0,0" Padding="12,9"
                              ItemsSource="{Binding SubtitleOptions}" SelectedItem="{Binding SubtitleLanguage}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="SAVE TO" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Height="40">
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}"
                                     BorderThickness="0" Padding="12,10" VerticalAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="16,10" Content="BROWSE" Click="Browse_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Padding="20,12" Margin="0,0,10,0"
                        Click="Cancel_Click" Content="CANCEL" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Padding="24,13"
                        Click="Download_Click" Content="DOWNLOAD" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
