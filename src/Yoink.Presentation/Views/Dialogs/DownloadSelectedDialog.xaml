<Window x:Class="Yoink.Presentation.Views.Dialogs.DownloadSelectedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yoink" Height="360" Width="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfacePrimaryBrush}"
        FontFamily="{StaticResource InterfaceFont}">
    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="HeadlineText" Text="DOWNLOAD 0 VIDEOS"
                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="They'll be queued and started right away using your current preset."
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <Border Grid.Row="2" Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="4" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="FORMAT" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FormatText" Text="MP4" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="QUALITY" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QualityText" Text="Best available" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="SAVE TO" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="FolderText" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Padding="20,12" Margin="0,0,10,0"
                        Click="Cancel_Click" Content="CANCEL" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Padding="24,13"
                        Click="Download_Click" Content="DOWNLOAD" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
