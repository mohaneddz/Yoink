<UserControl x:Class="Yoink.Presentation.Views.Pages.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:Yoink.Presentation.Views.Shared"
             xmlns:conv="clr-namespace:Yoink.Presentation.Converters"
             xmlns:controls="clr-namespace:Yoink.Presentation.Controls"
             xmlns:vm="clr-namespace:Yoink.Presentation.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ChannelsViewModel}">

    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
        <conv:ChannelUploadTypeConverter x:Key="UploadTypeConverter"/>
        <conv:FrequencyLabelConverter x:Key="FrequencyLabelConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ChannelListItem" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource OrangePrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UploadRowItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Per-upload actions. PlacementTarget.Tag carries the page VM. -->
        <ContextMenu x:Key="UploadRowMenu">
            <MenuItem Header="Download"
                      Command="{Binding PlacementTarget.Tag.DownloadLatestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Add to queue"
                      Command="{Binding PlacementTarget.Tag.AddSelectedToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconClipboard}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Mark as Seen / Unseen"
                      Command="{Binding PlacementTarget.Tag.ToggleSeenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconEye}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Open channel"
                      Command="{Binding PlacementTarget.Tag.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{DynamicResource TextPrimaryBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="40,0,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:PageHeaderView Grid.Row="0" HeaderTitle="CHANNELS" HeaderTagline="FOLLOW. REVIEW. QUEUE."/>

        <!-- Add channel bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0" Height="42">
                <TextBox Text="{Binding AddChannelUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldTextBox}" BorderThickness="0"
                         Padding="14,11" Tag="Paste YouTube channel URL, handle (@name), or link...">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddChannelCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </Border>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding AddChannelCommand}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconClipboard}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="White" Margin="0,0,8,0"/>
                    <TextBlock Text="ADD CHANNEL" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding AddChannelCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="INSPECT" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Channels list (left) -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupHeader}">
                    <Run Text="Following ("/><Run Text="{Binding Channels.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ChannelListItem}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0">
                                            <Grid.Clip>
                                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                            </Grid.Clip>
                                            <Ellipse Fill="{Binding AvatarHex}"/>
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="11" Height="11" Stroke="{StaticResource SuccessBrush}" Margin="5,0,0,0" Visibility="{Binding Verified, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubscriberCountText}" Style="{StaticResource MetaText}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Channel detail + uploads (center) -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                    <Grid DataContext="{Binding SelectedChannel}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="52" Height="52">
                                <Grid.Clip>
                                    <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26"/>
                                </Grid.Clip>
                                <Ellipse Fill="{Binding AvatarHex}"/>
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="17"/>
                                    <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="14" Height="14" Stroke="{StaticResource SuccessBrush}" Margin="6,0,0,0" Visibility="{Binding Verified, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HandleMeta}" Style="{StaticResource MetaText}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="LAST CHECKED" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding LastCheckedText}" FontSize="12" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="RECENT UPLOADS" Margin="0,0,22,0" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Recent Uploads"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='Recent Uploads', Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="VIDEOS" Margin="0,0,22,0" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Videos"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='Videos', Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="SHORTS" Margin="0,0,22,0" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Shorts"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='Shorts', Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="LIVESTREAMS" Margin="0,0,22,0" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Livestreams"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='Livestreams', Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="PLAYLISTS" Margin="0,0,22,0" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="Playlists"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='Playlists', Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource FilterTabButton}" GroupName="ChTab" Content="ABOUT" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="About"
                                 IsChecked="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumEqualsConverter}, ConverterParameter='About', Mode=OneWay}"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,-14,0,16"/>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Run Text="{Binding DataContext.SelectedUploadCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=" SELECTED"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DownloadSelectedButton" Style="{StaticResource PrimaryButton}" Padding="14,9" FontSize="12" Margin="0,0,8,0"
                                Click="DownloadSelectedButton_Click"
                                IsEnabled="{Binding DataContext.HasSelectedUploads, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="White" Margin="0,0,6,0"/>
                                <TextBlock Foreground="White" FontWeight="Bold">
                                    <Run Text="DOWNLOAD SELECTED ("/><Run Text="{Binding DataContext.SelectedUploadCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Margin="0,0,8,0" Command="{Binding DataContext.SelectUnseenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="SELECT ALL UNSEEN" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Margin="0,0,8,0" Command="{Binding DataContext.AddSelectedToQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="ADD TO QUEUE" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Margin="0,0,8,0" Command="{Binding DataContext.DownloadLatestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="DOWNLOAD LATEST" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Padding="12,9" FontSize="12" Command="{Binding DataContext.MarkAllAsSeenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="MARK ALL AS SEEN" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MetaText}">
                        <Run Text="Showing "/><Run Text="{Binding Uploads.Count, Mode=OneWay}"/><Run Text=" uploads"/>
                    </TextBlock>
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="16,9" FontSize="12" Content="LOAD MORE" FontWeight="Bold"
                            Command="{Binding DataContext.LoadMoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DataContext.UploadsView, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UploadRowItem}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ContextMenu="{StaticResource UploadRowMenu}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource TableCheckBox}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <Grid Grid.Column="1" Height="62" Margin="0,0,14,0" ClipToBounds="True">
                                            <Border Background="{Binding ThumbnailHex}" CornerRadius="2"/>
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="10" Background="#CC000000" Padding="4,1"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource MetaText}" Margin="0,4,0,0">
                                                <Run Text="{Binding DateText, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding ViewsText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Seen / Unseen / Downloaded Badge -->
                                            <Border Visibility="{Binding Downloaded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="{DynamicResource SurfaceSecondaryBrush}" Padding="6,2" Margin="0,0,8,0" CornerRadius="2">
                                                <TextBlock Text="DOWNLOADED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                            <Border Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Background="{StaticResource OrangePrimaryBrush}" Padding="6,2" Margin="0,0,8,0" CornerRadius="2">
                                                <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Media type badge -->
                                            <Border Background="{Binding Type, Converter={StaticResource UploadTypeConverter}, ConverterParameter=bg}" Padding="8,4" Margin="0,0,10,0" CornerRadius="2">
                                                <TextBlock Text="{Binding Type, Converter={StaticResource UploadTypeConverter}, ConverterParameter=label}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding Type, Converter={StaticResource UploadTypeConverter}, ConverterParameter=fg}"/>
                                            </Border>
                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="More actions"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ContextMenu="{StaticResource UploadRowMenu}"
                                                    controls:ButtonBehaviors.OpensContextMenu="True">
                                                <Path Data="{StaticResource IconMoreVertical}" Style="{StaticResource Icon}" Width="12" Height="12" Stroke="{DynamicResource TextMutedBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Channel inspector -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20" DataContext="{Binding SelectedChannel}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="CHANNEL INSPECTOR" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Grid Width="48" Height="48">
                            <Grid.Clip>
                                <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                            </Grid.Clip>
                            <Ellipse Fill="{Binding AvatarHex}"/>
                            <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                <Path Data="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" Width="13" Height="13" Stroke="{StaticResource SuccessBrush}" Margin="5,0,0,0" Visibility="{Binding Verified, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Handle}" Style="{StaticResource MetaText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource PlainHoverButton}" Command="{Binding DataContext.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open Channel" Foreground="{StaticResource OrangePrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                            <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource Icon}" Width="11" Height="11" Stroke="{StaticResource OrangePrimaryBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="{Binding SubscriberCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="SUBSCRIBERS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding VideoCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="VIDEOS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding ShortCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="SHORTS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="{Binding LiveCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="LIVE STREAMS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding PlaylistCountText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="PLAYLISTS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding TotalViewsText}" FontWeight="Bold" FontSize="16"/><TextBlock Text="TOTAL VIEWS" Style="{StaticResource FieldLabel}" FontSize="9"/></StackPanel>
                    </UniformGrid>

                    <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="CHANNEL INFO" Style="{StaticResource SectionTitleText}" FontSize="12" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Joined" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding JoinedText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Country" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding CountryText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Language" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding LanguageText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Last Checked" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding LastCheckedText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Next Check" Style="{StaticResource MetaText}" HorizontalAlignment="Left"/><TextBlock Text="{Binding NextCheckText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Check Frequency" Style="{StaticResource MetaText}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CheckFrequencyCombo" Style="{StaticResource FieldComboBox}" HorizontalAlignment="Right" Width="140" Padding="10,6"
                                  ItemsSource="{Binding DataContext.CheckFrequencyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding CheckFrequencyHours, Mode=OneWay}" SelectionChanged="CheckFrequencyCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource FrequencyLabelConverter}}" FontSize="12"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="ACTIONS" Style="{StaticResource SectionTitleText}" FontSize="12" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="OPEN CHANNEL" Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.OpenChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="DOWNLOAD LATEST" Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.DownloadLatestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="MARK ALL AS SEEN" Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.MarkAllAsSeenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource DestructiveButton}" Content="UNFOLLOW CHANNEL" Padding="12,10" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.UnfollowChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
