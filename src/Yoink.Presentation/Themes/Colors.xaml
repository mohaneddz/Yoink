<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dispatch identity palette (spec section 4.3) -->
    <Color x:Key="AppShellColor">#FF090909</Color>
    <Color x:Key="SidebarColor">#FF050505</Color>
    <Color x:Key="SurfacePrimaryColor">#FFF7F7F4</Color>
    <Color x:Key="SurfaceSecondaryColor">#FFEFEFED</Color>
    <Color x:Key="TextPrimaryColor">#FF111111</Color>
    <Color x:Key="TextMutedColor">#FF6D6D68</Color>
    <Color x:Key="DividerColor">#FFCFCFC9</Color>
    <Color x:Key="OrangePrimaryColor">#FFFF4F0A</Color>
    <Color x:Key="OrangeHoverColor">#FFE94300</Color>
    <Color x:Key="SuccessColor">#FF21A33A</Color>
    <Color x:Key="WarningColor">#FFD98A00</Color>
    <Color x:Key="ErrorColor">#FFD93025</Color>
    <Color x:Key="DisabledColor">#FFA7A7A1</Color>
    <Color x:Key="SidebarTextInactiveColor">#FFC9C9C4</Color>
    <Color x:Key="SidebarTextMutedColor">#FF7A7A76</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>

    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryButtonBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="RowHoverColor">#FFF0F0EC</Color>
    <Color x:Key="RowSelectedColor">#FFFCEEE7</Color>
    <Color x:Key="LogPanelColor">#FF0C0C0C</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppShellBrush" Color="{StaticResource AppShellColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource SurfacePrimaryColor}"/>
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{StaticResource SecondaryButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    <SolidColorBrush x:Key="OrangePrimaryBrush" Color="{StaticResource OrangePrimaryColor}"/>
    <SolidColorBrush x:Key="OrangeHoverBrush" Color="{StaticResource OrangeHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="SidebarTextInactiveBrush" Color="{StaticResource SidebarTextInactiveColor}"/>
    <SolidColorBrush x:Key="SidebarTextMutedBrush" Color="{StaticResource SidebarTextMutedColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="SidebarActiveBackgroundBrush" Color="#FF1A1310"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}"/>
    <SolidColorBrush x:Key="LogPanelBrush" Color="{StaticResource LogPanelColor}"/>

</ResourceDictionary>
