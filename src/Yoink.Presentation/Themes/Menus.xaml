<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== CONTEXT MENUS ==================== -->
    <!-- Implicit styles: every ContextMenu / MenuItem / Separator / ToolTip in the app is themed. -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0,5"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.16" Color="#FF000000"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="14,7" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Width="14" Height="14"/>
                            <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive menu item (e.g. Remove / Delete) -->
    <Style x:Key="DestructiveMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="10,5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared filename-template variable inserter. Host button's DataContext must expose
         InsertTemplateVariableCommand(string). -->
    <ContextMenu x:Key="TemplateVariableMenu">
        <MenuItem Header="Title  —  %(title)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(title)s"/>
        <MenuItem Header="Video ID  —  %(id)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(id)s"/>
        <MenuItem Header="Uploader  —  %(uploader)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(uploader)s"/>
        <MenuItem Header="Channel  —  %(channel)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(channel)s"/>
        <MenuItem Header="Upload date  —  %(upload_date)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(upload_date)s"/>
        <MenuItem Header="Resolution  —  %(resolution)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(resolution)s"/>
        <MenuItem Header="Extension  —  %(ext)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(ext)s"/>
        <Separator/>
        <MenuItem Header="Playlist name  —  %(playlist)s" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(playlist)s"/>
        <MenuItem Header="Playlist index  —  %(playlist_index)02d" Command="{Binding PlacementTarget.DataContext.InsertTemplateVariableCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="%(playlist_index)02d"/>
    </ContextMenu>

    <!-- ==================== TOOLTIPS ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource AppShellBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.2" Color="#FF000000"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
